{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/create-cashfree-order.js": {
      "includeFiles": "booking-data.js"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://www.shivrudracabs.com/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://www.shivrudracabs.com/:path",
      "permanent": true
    },
    {
      "source": "/sitemap",
      "destination": "/sitemap.xml",
      "permanent": false
    },
    {
      "source": "/site.xml",
      "destination": "/sitemap.xml",
      "permanent": false
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
