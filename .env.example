# Vercel Environment Variables Configuration for Aditya Cabs / Sahyadri Cabs

# 1. Admin Access
ADMIN_EMAILS="adityacabs70@gmail.com"

# 2. Firebase Database & Auth (Service Account JSON as a single line string)
FIREBASE_SERVICE_ACCOUNT="{\"type\":\"service_account\",\"project_id\":\"aditya-cabs\",...}"

# 3. WhatsApp OTP & Notification Service (Renflair)
RENFLAIR_API_KEY="your_renflair_api_key_here"

# 4. Session Security Secret (Hex-encoded 32+ byte string)
SESSION_SECRET="your_session_secret_here"

# 5. Cashfree Payment Gateway (Production)
CASHFREE_APP_ID="your_cashfree_app_id_here"
CASHFREE_SECRET_KEY="your_cashfree_secret_key_here"
CASHFREE_ENV="production"
CASHFREE_API_VERSION="2023-08-01"
